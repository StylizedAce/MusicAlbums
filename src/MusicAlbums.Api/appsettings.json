{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Library": "Data Source=musicalbums.db"
  },
  "AlbumProviders": {
    "Default": "deezer",
    "Deezer": {
      "BaseUrl": "https://api.deezer.com/",
      "TimeoutSeconds": 15
    }
  }
}
