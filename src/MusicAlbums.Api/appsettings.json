{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Library": "Data Source=musicalbums.db"
  },
  "AlbumProviders": {
    "Default": "deezer",
    "Deezer": {
      "BaseUrl": "https://api.deezer.com/",
      "TimeoutSeconds": 15
    },
    "Spotify": {
      "Mode": "Fake",
      "AccountsBaseUrl": "https://accounts.spotify.com/",
      "ApiBaseUrl": "https://api.spotify.com/v1/"
    }
  }
}
